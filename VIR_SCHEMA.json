{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvisionbridge.example/schema/vir/1.0.0",
  "title": "OpenVisionBridge Visual Intermediate Representation",
  "description": "Structured, confidence-aware visual evidence for interoperability between perception systems and AI reasoning systems.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "image",
    "analysis",
    "regions",
    "objects",
    "shapes",
    "text",
    "measurements",
    "relationships",
    "uncertainties"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "image": {
      "$ref": "#/$defs/image"
    },
    "analysis": {
      "$ref": "#/$defs/analysis"
    },
    "regions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/region"
      }
    },
    "objects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/object"
      }
    },
    "shapes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/shape"
      }
    },
    "text": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "measurements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/measurement"
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relationship"
      }
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/uncertainty"
      }
    }
  },
  "$defs": {
    "bbox": {
      "type": "array",
      "description": "[x_min, y_min, x_max, y_max] in image coordinates.",
      "prefixItems": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "number",
          "minimum": 0
        }
      ],
      "minItems": 4,
      "maxItems": 4
    },
    "point": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Evidence confidence estimate; not necessarily a calibrated probability."
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_type"
      ],
      "properties": {
        "source_type": {
          "type": "string",
          "enum": [
            "OCR",
            "GEOMETRY",
            "REGION_ANALYSIS",
            "OBJECT_DETECTOR",
            "VISION_MODEL",
            "SPATIAL_ENGINE",
            "USER_PROVIDED",
            "DERIVED",
            "OTHER"
          ]
        },
        "engine": {
          "type": "string"
        },
        "method": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "model": {
          "type": "string"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "confidence",
        "status"
      ],
      "properties": {
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "status": {
          "type": "string",
          "enum": [
            "DETECTED",
            "DERIVED",
            "INTERPRETED",
            "UNCERTAIN"
          ]
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "aspect_ratio": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "orientation": {
          "type": "string",
          "enum": [
            "portrait",
            "landscape",
            "square",
            "unknown"
          ]
        },
        "format": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "quality": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "brightness": {
              "$ref": "#/$defs/normalized"
            },
            "contrast": {
              "$ref": "#/$defs/normalized"
            },
            "blur": {
              "$ref": "#/$defs/normalized"
            }
          }
        }
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image_type"
      ],
      "properties": {
        "image_type": {
          "type": "string",
          "enum": [
            "DOCUMENT",
            "PHOTOGRAPH",
            "DIAGRAM",
            "CHART",
            "TABLE",
            "SCREENSHOT",
            "CAD",
            "HANDWRITTEN_CONTENT",
            "MIXED",
            "UNKNOWN"
          ]
        },
        "question": {
          "type": "string"
        },
        "selected_engines": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "processing_mode": {
          "type": "string",
          "enum": [
            "GLOBAL",
            "QUESTION_GUIDED",
            "TARGETED",
            "MULTI_PASS"
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "bbox",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "bbox": {
          "$ref": "#/$defs/bbox"
        },
        "parent_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      }
    },
    "object": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "bbox": {
          "$ref": "#/$defs/bbox"
        },
        "centroid": {
          "$ref": "#/$defs/point"
        },
        "region_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "attributes": {
          "type": "object",
          "additionalProperties": true
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      }
    },
    "shape": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "point",
            "line",
            "circle",
            "ellipse",
            "triangle",
            "rectangle",
            "square",
            "polygon",
            "arc",
            "unknown"
          ]
        },
        "bbox": {
          "$ref": "#/$defs/bbox"
        },
        "vertices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/point"
          }
        },
        "center": {
          "$ref": "#/$defs/point"
        },
        "radius": {
          "type": "number",
          "minimum": 0
        },
        "area": {
          "type": "number",
          "minimum": 0
        },
        "perimeter": {
          "type": "number",
          "minimum": 0
        },
        "orientation_degrees": {
          "type": "number"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      }
    },
    "text": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "content",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "content": {
          "type": "string"
        },
        "bbox": {
          "$ref": "#/$defs/bbox"
        },
        "language": {
          "type": "string"
        },
        "reading_order": {
          "type": "integer",
          "minimum": 0
        },
        "text_type": {
          "type": "string",
          "enum": [
            "paragraph",
            "heading",
            "label",
            "number",
            "equation",
            "table_cell",
            "caption",
            "unknown"
          ]
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "value",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "value": {
          "type": "number"
        },
        "unit": {
          "type": "string"
        },
        "subject_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject",
        "relation",
        "object",
        "evidence"
      ],
      "properties": {
        "subject": {
          "type": "string"
        },
        "relation": {
          "type": "string",
          "enum": [
            "LEFT_OF",
            "RIGHT_OF",
            "ABOVE",
            "BELOW",
            "INSIDE",
            "CONTAINS",
            "OVERLAPS",
            "INTERSECTS",
            "TOUCHES",
            "NEAR",
            "FAR",
            "CENTERED",
            "ALIGNED_X",
            "ALIGNED_Y",
            "CONNECTED_TO",
            "BETWEEN"
          ]
        },
        "object": {
          "type": "string"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      }
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "severity"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "severity": {
          "type": "string",
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH",
            "CRITICAL"
          ]
        },
        "affected_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "candidate_values": {
          "type": "array",
          "items": {}
        }
      }
    },
    "normalized": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  }
}
